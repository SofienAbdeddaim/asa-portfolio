# Copy to .env and fill in. Never commit real values.

# --- API ---
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/portfolio
# Front-end origin allowed by CORS and the Origin guard.
CORS_ORIGIN=http://localhost:4200
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=ASA Portfolio
# Cookies are Secure in production. Set to false only for plain-HTTP local development.
COOKIE_SECURE=false
# Swagger UI at /api/docs (default: enabled outside production).
SWAGGER_ENABLED=true
LOG_LEVEL=info

# --- Seed CLI: first admin (password of at least 12 characters) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
